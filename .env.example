# ─────────────────────────────────────────────────────────────────────────
# CPA First — 환경변수 예시. 실제 값은 .env (gitignore됨) 또는 PaaS 시크릿에 둘 것.
# prod에서는 PaaS 시크릿 매니저로 주입하고 이미지에 굽지 말 것.
# ─────────────────────────────────────────────────────────────────────────

# dev | staging | prod | test
ENVIRONMENT=dev

# ── Database ──────────────────────────────────────────────────────────────
# dev/test 기본은 SQLite. prod는 관리형 Postgres URL을 주입.
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite+pysqlite:///./data/runtime/cpa_dev.sqlite3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Auth / JWT ────────────────────────────────────────────────────────────
# prod에서는 반드시 강한 랜덤값(>=32자). 예: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# 첫 가입자를 admin으로 부트스트랩 (초기 1회용). prod 기본 false.
BOOTSTRAP_FIRST_USER_ADMIN=false

# ── Cookies (refresh token 전달) ──────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.example.com
REFRESH_COOKIE_NAME=cpa_refresh

# ── CORS (콤마 구분. prod는 '*' 금지, 명시적 허용목록) ──────────────────────
# same-origin StaticFiles 배포면 비워둬도 됨.
CORS_ORIGINS=

# ── Rate limits (slowapi 문법) ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute

# ── Logging / Observability ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# ── Knowledge base / Solver ───────────────────────────────────────────────
# SEED_DIR=  # 비우면 패키지 기본 위치
CPA_SOLVER_MODE=reasoned
# Live 벤치마크/solver용. 실제 키는 커밋 금지.
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
